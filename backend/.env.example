# ============================================================
# Environment Variables — Udhaar AI Backend
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+psycopg://user:pass@host:port/db?sslmode=require

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=your-secret-key

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- AI Integration (Optional) ---
# Obtain your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Model to use (default: gemini-2.0-flash)
AI_MODEL_NAME=gemini-2.0-flash
# Request timeout in seconds (default: 30)
AI_TIMEOUT=30
# Set to 'false' to disable AI features entirely (default: true)
AI_ENABLED=true
